# -----------------------------------------------------------------------------
# Cube.obj - 单位立方体网格（引擎正式磁盘资源，ObjMeshImporter 契约）
# 布局：position(3) + normal(3) + uv(2)，纯三角面（f v/vt/vn）
# -----------------------------------------------------------------------------

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vt 0 0
vt 1 0
vt 0 1
vt 1 1

vn 0  0 -1
vn 0  0  1
vn 0 -1  0
vn 0  1  0
vn -1 0  0
vn 1  0  0

f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2
f 1/1/3 5/2/3 6/3/3
f 1/1/3 6/3/3 2/2/3
f 4/1/4 3/2/4 7/3/4
f 4/1/4 7/3/4 8/4/4
f 1/1/5 4/2/5 8/3/5
f 1/1/5 8/3/5 5/4/5
f 2/1/6 3/2/6 7/3/6
f 2/1/6 7/3/6 6/4/6