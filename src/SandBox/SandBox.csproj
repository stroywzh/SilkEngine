<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <OutputPath>$(MSBuildProjectDirectory)\Build\$(Configuration)\</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <OutputPath>$(MSBuildProjectDirectory)\Build\Debug\</OutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputPath>$(MSBuildProjectDirectory)\Build\Release\</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SilkEngine.Rendering\SilkEngine.Rendering.csproj" />
        <ProjectReference Include="..\SilkEngine\SilkEngine.csproj" />
        <ProjectReference Include="..\SilkEngine.Asset\SilkEngine.Asset.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
